{
  "name": "machine-sim-starter",
  "version": "1.0.0",
  "description": "Multi-machine production line simulation (starter for the Track B hackathon case)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "check": "node src/headless/run.check.mjs",
    "reference": "node scripts/reference-check.mjs",
    "scenarios": "node scripts/run-scenarios.mjs",
    "advise": "node scripts/advise.mjs"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/static": "^7.0.4"
  }
}
